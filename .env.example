# VoiceStrike BUILD 7 v0.10.0
# Copy this file to .env and paste your AssemblyAI API key after the equals sign.
# Never commit or share the real .env file.
ASSEMBLYAI_API_KEY=
PORT=3001

# BUILD 7 reliability fault injection. Keep false for normal/demo use.
VOICESTRIKE_ENABLE_RELIABILITY_FAULTS=false
# Optional one-shot fault point when explicitly enabled.
VOICESTRIKE_FAULT_POINT=
